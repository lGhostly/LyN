---
const { admin = false, title = 'LyN' } = Astro.props;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
</head>
<body>
  <header>
    <a href="/" class="logo">🏺 LyN</a>
    <nav>
      {admin ? (<><a href="/admin">Panel</a><a href="/admin/logout">Salir</a></>) : <a href="/admin">Admin</a>}
    </nav>
  </header>
  <main><slot /></main>
</body>
</html>
<style is:global>
  :root { --bg:#fbf6ee; --card:#fff; --tx:#2b2118; --mut:#7a6a5a; --ac:#c2410c; --bd:#e8dccb; }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--bg); color:var(--tx); font-family:Georgia,serif; }
  header { display:flex; justify-content:space-between; align-items:center; padding:16px 20px; max-width:1100px; margin:auto; }
  header a { color:var(--tx); text-decoration:none; margin-left:14px; font-family:system-ui,sans-serif; }
  .logo { font-size:1.6rem; color:var(--ac)!important; margin:0!important; font-weight:700; }
  main { max-width:1100px; margin:auto; padding:0 16px 40px; font-family:system-ui,sans-serif; }
  input, textarea { font:inherit; width:100%; padding:10px; border:1px solid var(--bd); border-radius:8px; background:var(--card); color:var(--tx); }
  button, .btn { font:600 .9rem system-ui; padding:10px 14px; border:0; border-radius:8px; background:var(--ac); color:#fff; cursor:pointer; text-decoration:none; display:inline-block; }
  .sec { background:transparent; color:var(--tx); border:1px solid var(--bd); }
  .danger { background:#b91c1c; }
  .bar { display:flex; gap:10px; margin:12px 0; }
  .grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:16px; }
  .card { background:var(--card); border:1px solid var(--bd); border-radius:12px; overflow:hidden; color:inherit; text-decoration:none; display:flex; flex-direction:column; }
  .card img, .ph { width:100%; aspect-ratio:1; object-fit:cover; background:var(--bd); display:grid; place-items:center; color:var(--mut); }
  .card .b { padding:12px; display:flex; flex-direction:column; gap:6px; }
  .card h3 { margin:0; } .card p { margin:0; color:var(--mut); font-size:.85rem; }
  .price { font-weight:700; font-size:1.1rem; color:var(--ac); }
  .box { background:var(--card); border:1px solid var(--bd); border-radius:12px; padding:20px; max-width:560px; margin:auto; }
  label { display:block; margin:12px 0 4px; color:var(--mut); font-size:.85rem; }
  table { width:100%; border-collapse:collapse; background:var(--card); border-radius:12px; overflow:hidden; }
  td, th { padding:10px; border-bottom:1px solid var(--bd); text-align:left; }
  .row { display:flex; gap:8px; flex-wrap:wrap; }
  .thumbs { display:flex; gap:10px; flex-wrap:wrap; }
  .thumbs label { margin:0; text-align:center; font-size:.75rem; }
  .thumbs img { width:80px; height:80px; object-fit:cover; border-radius:8px; display:block; }
  .gal img { width:100%; border-radius:10px; margin-bottom:10px; }
  .err { color:#b91c1c; }
</style>
